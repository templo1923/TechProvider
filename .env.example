# TechProvider CLEAN - .env.example
# No hardcoded secrets - use placeholders below

APP_ID=811281598468466
APP_SECRET=your_app_secret_from_meta_developers_dashboard
WHATSAPP_CONFIG_ID=1889600718898450
CONFIG_ID=1889600718898450

# Create your own random verify token - placeholder pattern shown in modal
VERIFY_TOKEN=your-webhook-verify-token

# Upstash / Vercel KV - set one pair
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token
KV_REST_API_URL=https://your-kv-url.kv.vercel-storage.com
KV_REST_API_TOKEN=your_kv_token

# Encryption key for tokens at rest (32 bytes hex)
ENCRYPTION_KEY=generate_with_openssl_rand_hex_32

# Note: works without portfolio verification in dev mode
# Domain techproviderseller.vercel.app must be in App Domains and Valid OAuth Redirect URIs, app in Live

# Meta App - set in Vercel env dashboard, never hardcode in index.html
APP_ID=your-meta-app-id
APP_SECRET=your-meta-app-secret
# Embedded Signup Configuration ID - coexistence + message-blind flow (from Meta Developers > WhatsApp > Embedded Signup configs)
CONFIG_ID=1889600718898450

# Webhook verification - global fallback, per-connection token stored in KV takes precedence
VERIFY_TOKEN=change-me-to-a-secure-random-string

# Upstash Redis / Vercel KV (recommended scalable)
KV_REST_API_URL=https://your-upstash-url
KV_REST_API_TOKEN=your-upstash-token

# Alternative: Redis URL (self-hosted, Elasticache, etc.)
REDIS_URL=redis://default:password@host:6379

# Optional: Graph API version
GRAPH_VERSION=v20.0

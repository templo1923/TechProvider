{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/webhook",
      "dest": "/api/webhook.js"
    },
    {
      "src": "/api/exchange",
      "dest": "/api/exchange.js"
    },
    {
      "src": "/api/mapping",
      "dest": "/api/mapping.js"
    },
    {
      "src": "/api/connections",
      "dest": "/api/connections.js"
    },
    {
      "src": "/api/logs",
      "dest": "/api/logs.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.html"
    }
  ]
}